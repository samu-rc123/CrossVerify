          "rawSql": "SELECT created_at, request_id, champion_model, candidate_model, ROUND(champion_latency_ms::numeric, 1) AS champ_ms, ROUND(candidate_latency_ms::numeric, 1) AS cand_ms, ROUND(semantic_similarity::numeric, 3) AS similarity, structural_valid, discrepancy_detected, COALESCE(error_message, 'None') AS error_info, LEFT(prompt, 60) AS prompt_sample FROM evaluations ORDER BY created_at DESC LIMIT 50;",
