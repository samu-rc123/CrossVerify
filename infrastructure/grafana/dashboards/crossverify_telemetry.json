          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', created_at) AS \"time\", AVG(champion_latency_ms) AS \"Champion (Avg)\", percentile_cont(0.50) WITHIN GROUP (ORDER BY candidate_latency_ms) AS \"Candidate (p50)\", percentile_cont(0.95) WITHIN GROUP (ORDER BY candidate_latency_ms) AS \"Candidate (p95)\", percentile_cont(0.99) WITHIN GROUP (ORDER BY candidate_latency_ms) AS \"Candidate (p99)\" FROM evaluations WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1;",
