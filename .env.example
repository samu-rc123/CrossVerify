# Environment Configuration for CrossVerify
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Redis Configuration (Message Broker & Circuit Breaker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM_KEY=shadow_traffic
REDIS_CONSUMER_GROUP=crossverify_workers
REDIS_CONSUMER_NAME=worker_1

# PostgreSQL Configuration (Telemetry & Metric Store)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crossverify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/crossverify

# Canary Circuit Breaker Configuration
CANARY_ABORT_KEY=canary:abort_traffic
CANARY_EVAL_WINDOW_MINUTES=5
CANARY_DRIFT_THRESHOLD=0.05
CANARY_LATENCY_SPIKE_MS=1500

# Grafana Observability Dashboard
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin


